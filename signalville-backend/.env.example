# ============================================
# SignalVille - modele de configuration locale
# COPIER en .env et remplir avec tes valeurs
# ============================================

# --- Postgres ---
POSTGRES_DB=signalville
POSTGRES_USER=signalville
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# --- Backend Spring Boot ---
SIGNALVILLE_DB_URL=jdbc:postgresql://localhost:5433/signalville
SERVER_PORT=8080
SIGNALVILLE_UPLOAD_DIR=./uploads/reports
SIGNALVILLE_CORS_ALLOWED_ORIGINS=http://localhost:4200
SIGNALVILLE_LOG_LEVEL=DEBUG

# --- JWT (min 32 octets, encode en Base64) ---
# Genere avec : openssl rand -base64 48
SIGNALVILLE_JWT_SECRET=change-me-with-openssl-rand-base64-48

# --- Mailtrap SMTP (dev only - creer une inbox sur mailtrap.io) ---
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me

# --- SignalVille mail settings ---
MAIL_FROM=noreply@signalville.local
MAIL_FROM_NAME=SignalVille
MAIL_LOGIN_URL=http://localhost:4200/login